{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.gbenm/fire",
  "title": "Fire",
  "description": "Run your project's configured commands and share long-running dev servers with agents.",
  "repository": {
    "url": "https://github.com/gbenm/fire",
    "source": "github"
  },
  "websiteUrl": "https://github.com/gbenm/fire/blob/main/docs/mcp.md",
  "version": "3.3.0",
  "packages": [
    {
      "registryType": "cargo",
      "identifier": "fire-cli",
      "version": "3.3.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        { "type": "positional", "value": "cli" },
        { "type": "positional", "value": "mcp" }
      ]
    }
  ]
}
